{
  "expo": {
    "name": "Actv",
    "slug": "actv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ActvBlackLogo.png",
    "scheme": "active",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "y",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/images/ActvTransparent.png",
        "backgroundImage": "./assets/images/ActvBlackBG.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Actv"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ActvIcon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow this app to access your location at all times.",
          "locationWhenInUsePermission": "Allow this app to access your location when open."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "782c9ff4-bec8-4ff4-b09b-c75eac9f58f4"
      }
    },
    "owner": "RedLed"
  }
}