{
  "expo": {
    "name": "Actv",
    "slug": "actv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ActvBlackLogo.png",
    "scheme": "active",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "y",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/images/ActvTransparent.png",
        "backgroundImage": "./assets/images/ActvBlackBG.png",
        "monochromeImage": "./assets/images/ActvMonoLogo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Actv",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ActvIcon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/ActvBlackLogo.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow this app to access your location at all times.",
          "locationWhenInUsePermission": "Allow this app to access your location when open."
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-image",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "098a1b39-ad07-43ea-9df6-8a5242b45650"
      }
    },
    "owner": "redledfx"
  }
}
